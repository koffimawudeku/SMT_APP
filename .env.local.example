# Copiez ce fichier en .env.local et remplissez les valeurs
# (disponibles dans Supabase > Project Settings > API)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Utilisée uniquement côté serveur pour les opérations privilégiées
# (jamais exposée au navigateur, jamais préfixée NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Paiement Mobile Money (T-Money / Flooz) via CinetPay
# Créez un compte marchand sur https://cinetpay.com pour obtenir ces valeurs
CINETPAY_API_KEY=your-cinetpay-api-key
CINETPAY_SITE_ID=your-cinetpay-site-id

# URL publique de l'application (utilisée pour les redirections de paiement
# ET pour construire les liens des emails d'invitation / mot de passe)
NEXT_PUBLIC_APP_URL=https://votre-app.vercel.app

# Envoi d'emails transactionnels (invitations, réinitialisation de mot de
# passe) via Resend — https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx
# Expéditeur. Nécessite un domaine vérifié dans Resend pour envoyer à
# n'importe quel destinataire. En test, "onboarding@resend.dev" ne délivre
# qu'à l'adresse du titulaire du compte Resend.
RESEND_FROM=SMT <no-reply@votre-domaine.com>
