# Copiez ce fichier en .env.local et remplissez les valeurs
# (disponibles dans Supabase > Project Settings > API)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Utilisée uniquement côté serveur pour les opérations privilégiées
# (jamais exposée au navigateur, jamais préfixée NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
